# The TLS proxy of the app server (docs/deployment-plan.md). One host name per function. Each name passes on only the
# routes of its function, plus the health route; every other path gets 404.
#
# The host names come from the environment, so an operator of another deployment sets their own names and changes
# nothing here. On the server they are in /etc/caddy/zkb.env (see deploy/app-server/caddy.env.example), which a
# systemd drop-in loads. Caddy gets a certificate for each name itself, so each name needs an A or AAAA record that
# points at this server without a proxy in front: the backend trusts exactly one proxy hop (trustedProxyHops = 1).
#
#   prove     the dapp's proof flow: start a job, read its state, read the latest proof of a direction; and the
#             pipeline reads: where a transfer is and what it waits on (/progress), the batch, job and proof of a
#             direction (/directions/<direction>/pipeline) and the timings of each step (/benchmarks)
#   webhook   the prover's callback; the backend's publicUrl names this host
#   archive   evidence for messages that are sent and not yet delivered
#   indexer   the explorer indexer (Ponder): the read API and GraphQL, and at / a live page of its data (JSON on
#             request). /sql, /metrics and /status stay private.

{
	email {$ZKB_ACME_EMAIL}
}

# The upstreams are in two files that the playbooks in deploy/ansible own (docs/deploy-blue-green.md). Each one defines
# a snippet, backend and indexer_upstream (Caddy 2.6 cannot import a snippet from inside another snippet, so the file
# defines backend itself). caddy.yml writes them with the ports of ZKB_BACKEND_PORT (8787) and
# ZKB_INDEXER_PORT (42069), which is the routing this file had before they existed, and does so before it installs this
# file: an import of a missing file fails.
import /etc/caddy/upstreams/backend.caddy
import /etc/caddy/upstreams/indexer.caddy

(not_found) {
	handle {
		respond 404
	}
}

{$ZKB_PROVE_HOST} {
	@routes path /health /requests /requests/* /proofs/latest/* /progress/* /directions/* /benchmarks
	handle @routes {
		import backend
	}
	import not_found
}

{$ZKB_WEBHOOK_HOST} {
	@routes path /health /webhook/jobs/*
	handle @routes {
		import backend
	}
	import not_found
}

{$ZKB_ARCHIVE_HOST} {
	@routes path /health /evidence/*
	handle @routes {
		import backend
	}
	import not_found
}

{$ZKB_INDEXER_HOST} {
	@routes path /health /ready /api/* /graphql /graphql/*
	handle @routes {
		import indexer_upstream
	}
	# The address itself: a live page of the on-chain data (deploy/app-server/indexer-home, shipped with each release),
	# or the summary as JSON for a client that asks for JSON.
	@home_json {
		path /
		header Accept *application/json*
	}
	handle @home_json {
		rewrite * /api/summary
		import indexer_upstream
	}
	handle / {
		root * /opt/zk-bridge/current/deploy/app-server/indexer-home
		rewrite * /index.html
		file_server
	}
	import not_found
}
