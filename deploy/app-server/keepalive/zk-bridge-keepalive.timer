# RETIRED (2026-11-06): the backend's watcher owns keep-alive now; this unit is disabled on the app server and the status
# page no longer checks it. Kept for a manual backstop (docs/testnet-run.md, "Keeping the light clients alive").
# Runs zk-bridge-keepalive.service every three hours. A light client period is 22.75 hours on PulseChain and 27.3 on
# Ethereum; the backend proves a direction once its head is 12 hours old, so the head never ages past about 15 hours
# and the deadline (the end of the period after the head) stays more than 7 hours away. A missed run (server down)
# runs at boot (Persistent). systemd never starts the oneshot again while a run is still going.
[Unit]
Description=zk-bridge light client keep-alive, every three hours

[Timer]
OnCalendar=00/3:20
RandomizedDelaySec=10min
Persistent=true

[Install]
WantedBy=timers.target
