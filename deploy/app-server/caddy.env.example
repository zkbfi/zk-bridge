# The host names of deploy/app-server/Caddyfile. Copy to /etc/caddy/zkb.env on the server and set your own names.
# Nothing here is secret.
ZKB_ACME_EMAIL=ops@example.org
ZKB_PROVE_HOST=prove.example.org
ZKB_WEBHOOK_HOST=webhook.example.org
ZKB_ARCHIVE_HOST=archive.example.org
ZKB_INDEXER_HOST=indexer.example.org
# The local ports of the services. These are the defaults.
ZKB_BACKEND_PORT=8787
ZKB_INDEXER_PORT=42069
ZKB_STATUS_PORT=8790
# Optional; the Caddyfile defaults to status.zkb.fi.
ZKB_STATUS_HOST=status.example.org
