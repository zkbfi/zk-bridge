# /etc/zk-bridge/proofs/proofs.env (root, 0640). Read by zk-bridge-proofs-export.service. No secret belongs here.
#
# 1 = after each nightly export, also build the PUBLIC proof tree and add it to the IPFS node (proofs.sh publish).
# Leave it off (0) until the first publication has been made by hand and the owner has reviewed it:
#   /opt/zk-bridge/current/deploy/app-server/proofs.sh publish --dry-run   # builds the tree and prints its path
#   /opt/zk-bridge/current/deploy/app-server/proofs.sh publish             # adds it, logs the CID, prints the gateway form
ZKB_PROOFS_PUBLISH=0
# How many publications stay pinned (older CIDs of ipfs-cids.log are unpinned).
#ZKB_PROOFS_IPFS_KEEP=7
