{
  "schemaVersion": 1,
  "pair": "eth-pls",
  "deploymentFile": "/etc/zk-bridge/deployment.json",
  "databasePath": "/var/lib/zk-bridge-backend/backend.sqlite",
  "listen": { "host": "127.0.0.1", "port": 8787 },
  "trustForwardedHeader": true,
  "trustedProxyHops": 1,
  "modules": ["requests", "webhook", "msgboard-indexer", "archive", "rpc-proxy"],
  "publicUrl": "https://webhook.example.org",
  "prover": { "binary": "/opt/zk-bridge/current/bin/zk-bridge-prover", "timeoutSeconds": 1800 },
  "remote": {
    "endpoints": [
      { "label": "gpu-24gb", "url": "https://43nsvfb8svkosr.api.runpod.ai", "apiKeyVariable": "RUNPOD_API_KEY", "startWaitSeconds": 60 },
      { "label": "gpu-32gb", "url": "https://muecz9pudncily.api.runpod.ai", "apiKeyVariable": "RUNPOD_API_KEY", "startWaitSeconds": 30 },
      { "label": "gpu-48gb", "url": "https://nuax43o5zxyv9a.api.runpod.ai", "apiKeyVariable": "RUNPOD_API_KEY" }
    ]
  },
  "billing": { "refreshSeconds": 3600, "retrySeconds": 900 },
  "gpuGuard": { "enabled": true, "checkSeconds": 300, "stuckMinutes": 15, "spendCheckSeconds": 3600, "maxUsdPerHour": 0.5, "cooldownMinutes": 10, "maxTripsPerDay": 3 },
  "webhookBearerVariable": "BACKEND_WEBHOOK_BEARER",
  "rpcUrls": {
    "1": "https://ethereum-rpc.example.org",
    "369": "https://pulsechain-rpc.example.org"
  },
  "beaconUrls": {
    "1": "https://ethereum-beacon.example.org",
    "369": "https://pulsechain-beacon.example.org"
  },
  "stateUrls": {
    "1": ["https://ethereum-states.example.org"]
  },
  "msgboardUrl": "wss://msgboard.example.org",
  "acceptOracleProof": false,
  "limits": {
    "requestsPerCallerPerMinute": 10,
    "requestsPerUnknownCallerPerMinute": 2,
    "globalRequestsPerMinute": 120,
    "requestRetentionHours": 24,
    "secondsBeforeRetryAfterFailure": 60,
    "gpuBudgetUsdPerDirectionPerDay": 5,
    "keepAliveSeconds": 43200
  },
  "indexerUrl": "http://127.0.0.1:42069",
  "rpcProxy": {
    "upstreamUrl": "http://127.0.0.1:8792/zkb/evm/{chainId}",
    "timeoutSeconds": 30,
    "maxBodyBytes": 262144,
    "maxBatchLength": 50,
    "refreshSeconds": 300
  },
  "watch": {
    "pairs": {
      "sepolia-pls943": { "minIntervalSeconds": 3600, "unpricedAtMaximumPays": false, "companionProofs": true }
    },
    "warmup": { "enabled": false }
  }
}
