# The runner's hot wallet key. Copy to /etc/zk-bridge/bots/runner.env, mode 0640, owner root, group zkb_bots.
# Only the runner's unit loads it; the publisher's unit cannot see the file. Keep a small balance on this wallet.
# bots.json names it: runner.signer = { "kind": "private-key", "key": "env:RUNNER_PRIVATE_KEY" }.

# The private key, 0x and 64 hex digits.
RUNNER_PRIVATE_KEY=
