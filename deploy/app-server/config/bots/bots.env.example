# Secrets of both bots. Copy to /etc/zk-bridge/bots/bots.env, mode 0640, owner root, group zkb_bots.
# prover-setup.json and bots.json name these variables as references (env:NAME); they never hold the values.
# The runner's wallet key is in runner.env, which the publisher's unit cannot see.
#
# Its partners in /etc/zk-bridge/bots/, same mode and owner: bots.json (bots.json.example here) and
# prover-setup.json (prover-setup.json.example here). Both bots read the indexer at http://127.0.0.1:42069 and start
# the prover at /opt/zk-bridge/current/bin/zk-bridge-prover, where deploy.sh installs it.

# The key of the remote proving service (RunPod). The publisher passes it to the prover.
RUNPOD_API_KEY=
# The execution and beacon endpoints of each chain of the pair.
EXPLORER_RPC_URL_1=
EXPLORER_RPC_URL_369=
EXPLORER_BEACON_URL_1=
EXPLORER_BEACON_URL_369=
# The msgboard node (ws, wss, http or https).
MSGBOARD_URL=
