# Secrets of the status service. Copy to /etc/zk-bridge/status/status.env, mode 0640, owner root, group zkb_status.
# status.json names these variables (env:NAME); it never holds a value. The service has its own copies of the
# endpoints so that it reads no other service's files. Give it read-only endpoints; it sends no transaction.
#
# Its partner is /etc/zk-bridge/status/status.json (status.json.example here), same mode and owner.

# The execution RPC of each chain of the pair. It can carry a key.
STATUS_RPC_URL_11155111=
STATUS_RPC_URL_943=
# The beacon API of each chain (finalized header, and the light-client updates of the source chain).
STATUS_BEACON_URL_11155111=
STATUS_BEACON_URL_943=
# A RunPod API key that can read serverless endpoints (REST API v2). The service never calls the endpoint itself.
RUNPOD_API_KEY=
# Optional: the webhook URL that the status service posts to when a light client is about to strand (see "alerts" in
# the README of explorer/status). To turn it on, add "alerts": { "webhookUrl": "env:STATUS_ALERT_WEBHOOK_URL" } to
# status.json and set the variable here. Leave both out to keep alerts off.
# STATUS_ALERT_WEBHOOK_URL=
