# Settings and secrets of the explorer indexer. Copy to /etc/zk-bridge/indexer/indexer.env, mode 0640, owner root,
# group zkb_indexer. The endpoints can carry keys, so the whole file is private. See explorer/indexer/README.md.
#
# The unit already sets these, and a line here overrides it:
#   DATABASE_URL=postgresql:///zkb_indexer?host=/var/run/postgresql   (Postgres on the local socket, peer login)
#   EXPLORER_DEPLOYMENT_FILE=/etc/zk-bridge/deployment.json
#   PORT=42069                                                         (Caddyfile ZKB_INDEXER_PORT; on zkb.fi the public name is indexer.zkb.fi)
#   DATABASE_SCHEMA=indexer_<hash>                                     (from /opt/zk-bridge/current/release.env, one per indexer build)

# The pair: eth-pls (chains 1 and 369) or sepolia-pls943 (chains 11155111 and 943).
EXPLORER_PAIR=eth-pls

# The execution endpoint of each chain of the pair.
EXPLORER_RPC_URL_1=
EXPLORER_RPC_URL_369=

# The beacon endpoint of each chain. Optional: without it, finalizedSlot and lagSlots in /api/heads are null.
EXPLORER_BEACON_URL_1=
EXPLORER_BEACON_URL_369=
