{
  "schemaVersion": 1,
  "setupFile": "/etc/zk-bridge/publisher/prover-setup.json",
  "deploymentFile": "/etc/zk-bridge/deployment.json",
  "stateDirectory": "/var/lib/zk-bridge-publisher",
  "secretStore": {
    "kind": "none"
  },
  "logLevel": "info",
  "maximumMessageBytes": 8192,
  "publisher": {
    "prover": {
      "binary": "/opt/zk-bridge/current/bin/zk-bridge-prover",
      "timeoutSeconds": 1800
    },
    "apiKeyVariable": "RUNPOD_API_KEY",
    "remote": {
      "mode": "load-balancing"
    },
    "pollSeconds": 30,
    "republishSeconds": 600,
    "retryBackoffSeconds": 120,
    "indexerUrl": "http://127.0.0.1:42069"
  }
}
