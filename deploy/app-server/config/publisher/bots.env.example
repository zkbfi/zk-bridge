# Secrets of the publisher. Copy to /etc/zk-bridge/publisher/bots.env, mode 0640, owner root, group zkb_publisher.
# prover-setup.json and bots.json name these variables as references (env:NAME); they never hold the values.
#
# Its partners in /etc/zk-bridge/publisher/, same mode and owner: bots.json (bots.json.example here) and
# prover-setup.json (prover-setup.json.example here). The publisher reads the indexer at http://127.0.0.1:42069 and
# starts the prover at /opt/zk-bridge/current/bin/zk-bridge-prover, where deploy.sh installs it.

# The key of the remote proving service (RunPod). The publisher passes it to the prover.
RUNPOD_API_KEY=
# The execution and beacon endpoints of each chain of the pair.
EXPLORER_RPC_URL_1=
EXPLORER_RPC_URL_369=
EXPLORER_BEACON_URL_1=
EXPLORER_BEACON_URL_369=
# Optional: more beacon APIs for states only, comma separated, asked in order when the beacon endpoint does not serve an
# old state. The prover also keeps every state it verified in <stateDirectory>/beacon-states.
# EXPLORER_STATE_URLS_1=
# EXPLORER_STATE_URLS_369=
# The msgboard node (ws, wss, http or https).
MSGBOARD_URL=
