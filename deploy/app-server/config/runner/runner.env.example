# The runner's hot wallet key. Copy to /etc/zk-bridge/runner/runner.env, mode 0640, owner root, group zkb_runner.
# Only the runner's user can read it; the publisher runs as another user. Keep a small balance on this wallet.
# bots.json names it: runner.signer = { "kind": "private-key", "key": "env:RUNNER_PRIVATE_KEY" }.

# The private key, 0x and 64 hex digits.
RUNNER_PRIVATE_KEY=
