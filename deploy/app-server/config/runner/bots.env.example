# Secrets of the runner, except the wallet key (runner.env). Copy to /etc/zk-bridge/runner/bots.env, mode 0640,
# owner root, group zkb_runner. prover-setup.json and bots.json name these variables as references (env:NAME).
#
# Its partners in /etc/zk-bridge/runner/, same mode and owner: bots.json (bots.json.example here), prover-setup.json
# (prover-setup.json.example here) and runner.env. The runner reads the indexer at http://127.0.0.1:42069 and starts
# the prover at /opt/zk-bridge/current/bin/zk-bridge-prover, where deploy.sh installs it.

# The execution and beacon endpoints of each chain of the pair.
EXPLORER_RPC_URL_1=
EXPLORER_RPC_URL_369=
EXPLORER_BEACON_URL_1=
EXPLORER_BEACON_URL_369=
# Optional: more beacon APIs for states only, comma separated, asked in order when the beacon endpoint does not serve an
# old state. The prover also keeps every state it verified in <stateDirectory>/beacon-states.
# EXPLORER_STATE_URLS_1=
# EXPLORER_STATE_URLS_369=
# The msgboard node (ws, wss, http or https).
MSGBOARD_URL=
