# The secret of eRPC behind rpc.zkb.fi (docs/rpc-proxy.md). Copy to /etc/zk-bridge/erpc/erpc.env, mode 0640,
# owner root, group zkb_erpc. erpc.yaml names VALVE_RPC_KEY; it never holds the value.

# The server's valve.city key (the unlimited one the backend and the runner use). It goes into the path of each
# upstream: https://one.valve.city/rpc/<key>/evm/<chainId>. From the 1Password vault of the deployment.
VALVE_RPC_KEY=
