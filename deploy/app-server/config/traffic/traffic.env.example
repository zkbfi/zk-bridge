# The traffic bot's wallet key (testnets only). Copy to /etc/zk-bridge/traffic/traffic.env, mode 0640, owner root, group
# zkb_traffic. Only the traffic bot's user can read it; the runner and the publisher run as other users.
# bots.json names it: traffic.signer = { "kind": "private-key", "key": "env:TRAFFIC_PRIVATE_KEY" }.
# The wallet holds the test tokens and test coins of both chains; never a key of a wallet with real value.

# The private key, 0x and 64 hex digits. 1Password: zkb.fi / testnet traffic wallet.
TRAFFIC_PRIVATE_KEY=
