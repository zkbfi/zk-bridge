# Endpoints of the traffic bot (testnets), except the wallet key (traffic.env). Copy to /etc/zk-bridge/traffic/bots.env,
# mode 0640, owner root, group zkb_traffic. prover-setup.json names these variables as references (env:NAME).
#
# Its partners in /etc/zk-bridge/traffic/, same mode and owner: bots.json (bots.json.example here), prover-setup.json
# (prover-setup.json.example here; the traffic bot reads only the pair and the RPC endpoints from it) and traffic.env.
# The test token file comes with the release: /opt/zk-bridge/current/deploy/deployments/sepolia-pls943.test-tokens.json.

# The execution endpoint of each chain of the pair.
EXPLORER_RPC_URL_11155111=
EXPLORER_RPC_URL_943=
