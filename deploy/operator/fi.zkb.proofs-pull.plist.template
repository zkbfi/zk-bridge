<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Pulls the newest proof archive bundle from the app server once a day (install-proofs-pull.sh fills in the @...@
     values and loads this). launchd uses the local time zone; a run missed while the Mac sleeps happens at wake. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>fi.zkb.proofs-pull</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>@SCRIPT@</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:/usr/local/bin</string>
		<key>HOME</key>
		<string>@HOME@</string>
		<key>ZKB_PULL_NODE</key>
		<string>@NODE@</string>
		<key>ZKB_PULL_LOCAL_DIR</key>
		<string>@LOCAL_DIR@</string>
	</dict>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>@HOUR@</integer>
		<key>Minute</key>
		<integer>@MINUTE@</integer>
	</dict>
	<key>RunAtLoad</key>
	<false/>
	<key>ProcessType</key>
	<string>Background</string>
	<key>Nice</key>
	<integer>10</integer>
	<key>StandardOutPath</key>
	<string>@LOCAL_DIR@/launchd.log</string>
	<key>StandardErrorPath</key>
	<string>@LOCAL_DIR@/launchd.log</string>
</dict>
</plist>
