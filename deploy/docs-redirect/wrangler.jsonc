{
  // docs.zkb.fi redirects to the docs on IPFS (see worker.js). Deploy: npx wrangler deploy -c deploy/docs-redirect/wrangler.jsonc
  "name": "zkb-fi-docs",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "routes": [{ "pattern": "docs.zkb.fi", "custom_domain": true }],
  "workers_dev": false
}
