{
  "compilerOptions": {
    "lib": [
      "ESNext",
      "DOM"
    ],
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "@opentui/react",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "types": [
      "bun"
    ],
    "paths": {
      "@zk-bridge/shared": [
        "../shared/src/index.ts"
      ],
      "@zk-bridge/shared/config": [
        "../shared/src/config/index.ts"
      ],
      "@zk-bridge/shared/prover": [
        "../shared/src/prover/index.ts"
      ],
      "@zk-bridge/shared/backend-client": [
        "../shared/src/backend-client.ts"
      ],
      "@zk-bridge/shared/msgboard-http": [
        "../shared/src/msgboard/board-http.ts"
      ]
    }
  },
  "include": [
    "src/**/*",
    "test/**/*"
  ]
}
