{
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "types": ["bun"],
    "paths": {
      "@terminal/*": ["../terminal/src/*"],
      "@zk-bridge/shared": ["../shared/src/index.ts"],
      "@zk-bridge/shared/config": ["../shared/src/config/index.ts"]
    }
  },
  "include": ["src/**/*", "test/**/*"]
}
