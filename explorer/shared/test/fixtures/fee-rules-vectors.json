    "PROOF_COST_MICRO_USD": "25000",
    "COST_MARGIN": "2",
    "DEFAULT_CAP_WAD": "10000000000000000",
    "NO_PRICE_SHARE_WAD": "1000000000000000",
    "GAS_LEVELS": {
      "1": {
        "ceilingFactor": "2",
        "expectedHalves": "2"
      },
      "2": {
        "ceilingFactor": "3",
        "expectedHalves": "3"
      },
      "3": {
        "ceilingFactor": "5",
        "expectedHalves": "5"
      }
    }
  },
