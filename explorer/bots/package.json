{
  "name": "@zk-bridge/bots",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The proof publisher and the delivery runner of the zk-bridge explorer.",
  "bin": {
    "zk-bridge-bot": "./bin/zk-bridge-bot.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node bin/zk-bridge-bot.mjs",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@msgboard/sdk": "0.4.0",
    "@zk-bridge/shared": "workspace:*",
    "tsx": "4.23.15",
    "viem": "2.56.9",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "@types/ws": "8.18.1",
    "@vitest/coverage-v8": "4.1.11",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "ws": "8.21.3"
  }
}
