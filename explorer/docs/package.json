{
  "name": "@zk-bridge/docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The documentation pages of zk-bridge as source for the dapp: the help pages and the operator documents, built from Markdown. The dapp loads them lazily at #/docs; there is no separate site or archive.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "gate": "../../script/check-docs-public.sh",
    "check:machine": "node scripts/check-machine-docs.ts"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.1",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "4.1.11"
  }
}
