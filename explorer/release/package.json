{
  "name": "@zk-bridge/release",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Release pipeline: packs the sites into content-addressed archives, writes and signs version.json, and checks a release directory.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
