    "blockstore-core": "7.0.1",
    "ipfs-unixfs-exporter": "16.2.3",
    "ipfs-unixfs-importer": "17.1.1",
    "multiformats": "14.0.5"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "@vitest/coverage-v8": "4.1.11",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
