# Build settings of a release. Load them into the shell before release.sh:
#
#   set -a; . script/release/release.env; set +a
#
# Every value here ends up in the public dapp, so only public, keyless endpoints belong here. The dapp's own secret
# check (explorer/web/src/config/secret-scan.ts) refuses anything key-like at build time.
#
# The dapp serves every pair that has a file in deploy/deployments/ (the file name is the pair name). It opens the
# first one, or the one that ?pair= or a #/pair/ route asks for.
VITE_EXPLORER_DATA=live
VITE_EXPLORER_INDEXER_URL=https://indexer.zkb.fi
VITE_EXPLORER_BACKEND_URL=https://prove.zkb.fi
VITE_EXPLORER_ARCHIVE_URL=https://archive.zkb.fi
# RPCs default to the valve.city demo key for every chain (src/config/environment.ts); users replace them in Settings.
# The deployments of all pairs, inline, so the page needs no extra request.
VITE_EXPLORER_DEPLOYMENTS_JSON=$(jq -cn 'reduce inputs as $d ({}; . + {(input_filename | split("/") | last | rtrimstr(".json")): $d})' "$(git rev-parse --show-toplevel)"/deploy/deployments/*.json)
