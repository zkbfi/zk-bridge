# Build settings of a testnet release (pair sepolia-pls943). Load them into the shell before release.sh:
#
#   set -a; . script/release/testnet.env; set +a
#
# Every value here ends up in the public dapp, so only public, keyless endpoints belong here. The dapp's own secret
# check (explorer/web/src/config/secret-scan.ts) refuses anything key-like at build time.
VITE_EXPLORER_DATA=live
VITE_EXPLORER_PAIR=sepolia-pls943
VITE_EXPLORER_INDEXER_URL=https://indexer.zkb.fi
VITE_EXPLORER_BACKEND_URL=https://prove.zkb.fi
VITE_EXPLORER_ARCHIVE_URL=https://archive.zkb.fi
VITE_EXPLORER_RPC_URL_11155111=https://ethereum-sepolia-rpc.publicnode.com
VITE_EXPLORER_RPC_URL_943=https://rpc-testnet-pulsechain.g4mm4.io
# The contracts of the testnet deployment of 2026-10-29, inline, so the page needs no extra request.
VITE_EXPLORER_DEPLOYMENT_JSON=$(cat "$(git rev-parse --show-toplevel)/deploy/testnet/deployment.json")
