pragma solidity ^0.8.20;

import "@openzeppelin/contracts/token/ERC20/IERC20.sol";

interface ISP1Verifier {
    // Production verifiers take a single hashed bytes32 of public inputs
    function verify(bytes32 programVKey, bytes32 publicInputsHash, bytes calldata proof) external view returns (bool);
}

interface ILightClientSync {
    // Connects to the external consensus layer tracking validator sync committees
    function isVerifiedBlockRoot(bytes32 blockRoot) external view returns (bool);
}

contract ZKBridgeVault {
    // Struct layout precisely matches the memory alignment of BridgePublicInputs in Rust
    struct BridgeInputs {
        uint64 sourceChainId;
        uint64 targetChainId;
        address tokenAddress;
        address recipient;
        uint256 amount;
        bytes32 depositNonce;
        bytes32 confirmedBlockRoot;
    }

    // Hardcoded immutable architecture endpoints
    ISP1Verifier public immutable sp1Verifier;
    ILightClientSync public immutable syncRegistry;
    bytes32 public immutable programVKey;
    uint64 public immutable currentChainId;

    // Track completed bridge transactions to prevent replay attacks (Nullifiers)
    mapping(bytes32 => bool) public processedNonces;

    event DepositInitiated(
        address indexed token, 
        address indexed sender, 
        address indexed recipient, 
        uint256 amount, 
        bytes32 nonce, 
        uint64 targetChainId
    );
    
    event WithdrawalCompleted(
        address indexed token, 
        address indexed recipient, 
        uint256 amount, 
        bytes32 nonce
    );

    constructor(address _sp1Verifier, bytes32 _programVKey, uint64 _currentChainId, address _syncRegistry) {
        require(_sp1Verifier != address(0), "Invalid verifier address");
        require(_syncRegistry != address(0), "Invalid sync registry address");
        
        sp1Verifier = ISP1Verifier(_sp1Verifier);
        programVKey = _programVKey; // The frozen mathematical fingerprint of your Rust circuit
        currentChainId = _currentChainId;
        syncRegistry = ILightClientSync(_syncRegistry); // Integrated consensus pointer
    }

    /**
     * @notice Lock assets on the source chain to bridge them out.
     */
    function deposit(address token, address recipient, uint256 amount, uint64 targetChainId) external {
        require(amount > 0, "Amount must be greater than 0");
        require(targetChainId != currentChainId, "Cannot bridge to the same chain");

        // Generate a mathematically deterministic unique nonce
        bytes32 nonce = keccak256(abi.encodePacked(msg.sender, recipient, amount, block.timestamp, block.prevrandao));

        // Pull tokens from user into this immutable vault (Requires user pre-approval on ERC20)
        IERC20(token).transferFrom(msg.sender, address(this), amount);

        emit DepositInitiated(token, msg.sender, recipient, amount, nonce, targetChainId);
    }

     /**
     * @notice Claim assets permissionlessly by providing the ZK-SNARK proof generated by the user.
     * @dev Protocol fees are 0% because the user (msg.sender) pays their own destination gas fees directly.
     */
    function withdraw(bytes calldata proof, bytes calldata publicInputsBytes) external {
        // 1. Decode public inputs coming from the ZK proof execution
        BridgeInputs memory inputs = abi.decode(publicInputsBytes, (BridgeInputs));

        // 2. Bind parameters to their calculated storage layout hash
        // This stops hackers from providing mismatched raw public inputs to trick the verifier.
        bytes32 calculatedHash = keccak256(publicInputsBytes);

        // 3. Basic safety and execution context validations
        require(inputs.targetChainId == currentChainId, "Invalid target chain execution");
        require(!processedNonces[inputs.depositNonce], "Bridge transaction already claimed");
        
        // 4. Query the LightClientSync contract to ensure the block root is verified by consensus
        require(syncRegistry.isVerifiedBlockRoot(inputs.confirmedBlockRoot), "Block root not yet confirmed by consensus layer");

        // 5. Verify the ZK proof against the frozen Program VKey using the checked public input hash
        bool isValidProof = sp1Verifier.verify(programVKey, calculatedHash, proof);
        require(isValidProof, "Invalid cryptographic bridge proof");

        // 6. Update state to clear the nullifier BEFORE moving funds to eliminate reentrancy
        processedNonces[inputs.depositNonce] = true;

        // 7. Release funds to the recipient
        IERC20(inputs.tokenAddress).transfer(inputs.recipient, inputs.amount);

        emit WithdrawalCompleted(inputs.tokenAddress, inputs.recipient, inputs.amount, inputs.depositNonce);
    }
}