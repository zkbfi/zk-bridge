pragma solidity ^0.8.24;

import {BeaconLightClient} from "../../../src/hardened/BeaconLightClient.sol";
import {MessageBridge} from "../../../src/hardened/MessageBridge.sol";
import {BeaconProofVerifier} from "../../../src/hardened/BeaconProofVerifier.sol";
import {BeaconBlockHeader, SSZ} from "../../../src/hardened/SSZ.sol";
import {HardenedFixture} from "./HardenedFixture.sol";
import {MessageFixtures} from "./MessageFixtures.sol";
import {ForkProofs} from "./ForkProofs.sol";

/// @notice Builds synthetic message evidence. The receipts trie, the transactions trie and their proofs come from
/// `MessageFixtures` (generated by a script). The beacon levels above them are built here, as real sparse Merkle trees,
/// so that the same anchor can prove a source header AND validate the fork layout of a bridge from stored data.
///
/// One scene stores these headers in the light client, in slot order: two body evidence headers around the source
/// slot (D - 40 and D + 40), two filler headers (A - 80 and A - 40), and the anchor A. Then it adds the layouts to every
/// bridge that the test registered in `createdBridges`.
abstract contract WithdrawalScenes is HardenedFixture {
    /// @param anchorSlot The slot A of the anchor header.
    /// @param depositSlot The slot D of the header of the source block.
    /// @param blockRootsGindex The `block_roots` position in the state of the anchor.
    /// @param anchorBodyGindex The block hash position in the body of the anchor and of the evidence headers.
    /// @param blockHashGindex The block hash position in the body of the source header and of its evidence headers.
    /// @param sourceShape The shape of the state of the source header: a plain depth (6 by default), or
    /// `ForkProofs.PROGRESSIVE` for a Gloas source. The message proof carries its fork proof.
    /// @param genesisRoot The genesis validators root that every state of the scene holds: the root of the chain that the
    /// light client of the scene tracks (`GENESIS_ROOT_A` by default, for `lightClientForB`).
    struct SceneParams {
        uint64 anchorSlot;
        uint64 depositSlot;
        uint256 blockRootsGindex;
        uint256 anchorBodyGindex;
        uint256 blockHashGindex;
        uint8 sourceShape;
        bytes32 genesisRoot;
    }

    /// @notice The result of building a scene.
    struct Scene {
        MessageBridge.MessageProof proof;
        bytes32 anchorRoot;
        bytes32 blockHash;
        BeaconProofVerifier.BlockRootsEvidence rootsEvidence;
        BeaconProofVerifier.BlockHashEvidence anchorBodyEvidence;
        BeaconBlockHeader evidenceBefore;
        bytes32[] evidenceBeforeBranch;
        BeaconBlockHeader evidenceAfter;
        bytes32[] evidenceAfterBranch;
    }

    uint64 internal constant FIRST_ANCHOR_SLOT = 826_000;
    uint64 internal nextAnchorSlot;
    /// @dev The bridges that `_scene` adds the fork layouts to. A builder of a bridge registers it here.
    BeaconProofVerifier[] internal createdBridges;

    function setUp() public virtual override {
        super.setUp();
        nextAnchorSlot = FIRST_ANCHOR_SLOT;
    }

    /// @notice Registers a bridge for `_scene`, once: a bridge that a test rebuilds at the same address stays one entry.
    function _registerBridge(BeaconProofVerifier bridge_) internal {
        for (uint256 i = 0; i < createdBridges.length; i++) {
            if (address(createdBridges[i]) == address(bridge_)) return;
        }
        createdBridges.push(bridge_);
    }

    /// @notice The execution header that holds the roots of the message tries of `MessageFixtures`.
    function _messageHeaderRlp() internal pure returns (bytes memory) {
        return _executionHeaderRlp(MessageFixtures.RECEIPTS_ROOT, MessageFixtures.TRANSACTIONS_ROOT, 17);
    }

    /// @notice The default scene: anchor in an Electra-like fork (state position 69, block hash position 812), deposit
    /// 2000 slots earlier with the Deneb block hash position 812 too.
    function _defaultParams() internal returns (SceneParams memory) {
        uint64 anchorSlot = nextAnchorSlot;
        nextAnchorSlot = anchorSlot + 200; // room for the evidence headers of the next scene
        return SceneParams({
            anchorSlot: anchorSlot,
            depositSlot: anchorSlot - 2000,
            blockRootsGindex: 69,
            anchorBodyGindex: 812,
            blockHashGindex: 812,
            sourceShape: 6,
            genesisRoot: GENESIS_ROOT_A
        });
    }

    // ---------------------------------------------------------------- slot helpers

    function _fillerSlotA(SceneParams memory p) internal pure returns (uint64) {
        return p.anchorSlot - 80;
    }

    function _fillerSlotB(SceneParams memory p) internal pure returns (uint64) {
        return p.anchorSlot - 40;
    }

    function _fillerRoot(uint64 slot) internal pure returns (bytes32) {
        return keccak256(abi.encode("filler header root", slot));
    }

    // ---------------------------------------------------------------- scene building

    /// @notice Builds a scene for one named message, stores its headers, and adds the layouts to every created bridge.
    function _scene(MessageFixtures.Named memory named, SceneParams memory params) internal returns (Scene memory scene) {
        return _sceneWithHeader(named, params, _messageHeaderRlp());
    }

    function _sceneWithHeader(MessageFixtures.Named memory named, SceneParams memory params, bytes memory headerRlp)
        internal
        returns (Scene memory scene)
    {
        scene = _buildScene(named, params, headerRlp);
        _storeScene(params, scene);
        for (uint256 i = 0; i < createdBridges.length; i++) {
            _addLayouts(createdBridges[i], params, scene);
        }
    }

    /// @notice Stores the headers of a scene in `lightClientForB` (the light client of the A to B direction), in slot
    /// order. Slots at or below the head are skipped: an earlier scene stored them.
    function _storeScene(SceneParams memory params, Scene memory scene) internal {
        _storeScene(lightClientForB, GENESIS_ROOT_A, params, scene);
    }

    /// @notice The same for any light client. `genesisRoot` is the genesis validators root that the client tracks.
    function _storeScene(
        BeaconLightClient client,
        bytes32 genesisRoot,
        SceneParams memory params,
        Scene memory scene
    ) internal {
        _storeIfAhead(client, genesisRoot, scene.evidenceBefore.slot, SSZ.hashTreeRootMemory(scene.evidenceBefore));
        _storeIfAhead(client, genesisRoot, scene.evidenceAfter.slot, SSZ.hashTreeRootMemory(scene.evidenceAfter));
        _storeIfAhead(client, genesisRoot, _fillerSlotA(params), _fillerRoot(_fillerSlotA(params)));
        _storeIfAhead(client, genesisRoot, _fillerSlotB(params), _fillerRoot(_fillerSlotB(params)));
        _storeIfAhead(client, genesisRoot, params.anchorSlot, scene.anchorRoot);
    }

    function _storeIfAhead(BeaconLightClient client, bytes32 genesisRoot, uint64 slot, bytes32 headerRoot) internal {
        if (slot <= client.head()) return;
        _storeAnchor(client, genesisRoot, slot, headerRoot);
    }

    /// @notice Stores `headerRoot` as the finalized header at `slot` of `lightClientForB` through an honest update. The
    /// execution block hash is `keccak256(abi.encode("exec", slot))`.
    function _storeAnchor(uint64 slot, bytes32 headerRoot) internal {
        _storeAnchor(lightClientForB, GENESIS_ROOT_A, slot, headerRoot);
    }

    /// @notice The same for any light client.
    function _storeAnchor(BeaconLightClient client, bytes32 genesisRoot, uint64 slot, bytes32 headerRoot) internal {
        BeaconLightClient.LightClientOutput memory output = _outputAt(client, genesisRoot, slot, _execHash(slot));
        output.newHeaderRoot = headerRoot;
        _submit(client, output);
    }

    function _execHash(uint64 slot) internal pure returns (bytes32) {
        return keccak256(abi.encode("exec", slot));
    }

    /// @notice Adds the layouts of a scene to `bridge`, where the evidence is stored in `lightClientForB`. Layouts that
    /// the bridge already holds are widened.
    function _addLayouts(BeaconProofVerifier bridge_, SceneParams memory params, Scene memory scene) internal {
        _addLayouts(bridge_, lightClientForB, params, scene);
    }

    /// @notice The same for the light client that holds the evidence. A progressive (Gloas) source takes no body layout,
    /// and a progressive anchor gives none: the bridge refuses both (`GloasSlotRefused`), and the source reads the bid.
    function _addLayouts(
        BeaconProofVerifier bridge_,
        BeaconLightClient client,
        SceneParams memory params,
        Scene memory scene
    ) internal {
        bool plainSource = params.sourceShape != ForkProofs.PROGRESSIVE;
        if (plainSource && client.headers(scene.evidenceBefore.slot) == SSZ.hashTreeRootMemory(scene.evidenceBefore)) {
            bridge_.addBlockHashLayout(
                params.blockHashGindex,
                _hashEvidence(scene.evidenceBefore, scene.evidenceBeforeBranch, params.genesisRoot)
            );
        }
        if (plainSource && client.headers(scene.evidenceAfter.slot) == SSZ.hashTreeRootMemory(scene.evidenceAfter)) {
            bridge_.addBlockHashLayout(
                params.blockHashGindex, _hashEvidence(scene.evidenceAfter, scene.evidenceAfterBranch, params.genesisRoot)
            );
        }
        if (client.headers(params.anchorSlot) == scene.anchorRoot) {
            bridge_.addBlockRootsLayout(params.blockRootsGindex, scene.rootsEvidence);
            if (ForkProofs.shapeOfBlockRoots(params.blockRootsGindex) != ForkProofs.PROGRESSIVE) {
                bridge_.addBlockHashLayout(params.anchorBodyGindex, scene.anchorBodyEvidence);
            }
        }
    }

    /// @notice Builds a scene with an explicit execution header encoding. Nothing is stored.
    function _buildScene(MessageFixtures.Named memory named, SceneParams memory params, bytes memory headerRlp)
        internal
        pure
        returns (Scene memory scene)
    {
        scene.blockHash = keccak256(headerRlp);

        // Source header: its body holds the execution block hash at the block hash position, and its state has the shape
        // that the parameters name.
        bytes32[] memory hashBranch = _siblings(SSZ.depthOf(params.blockHashGindex), "hash", params.depositSlot);
        ForkProofs.ForkedState memory sourceState = ForkProofs.state(params.sourceShape, params.genesisRoot);
        BeaconBlockHeader memory depositHeader = BeaconBlockHeader({
            slot: params.depositSlot,
            proposerIndex: 7,
            parentRoot: keccak256(abi.encode("deposit parent", params.depositSlot)),
            stateRoot: sourceState.root,
            bodyRoot: _rootFromBranch(scene.blockHash, hashBranch, params.blockHashGindex)
        });

        ForkProofs.ForkedState memory anchorState = _anchorState(params, SSZ.hashTreeRootMemory(depositHeader));
        scene.anchorBodyEvidence = _anchorBodyEvidence(params, anchorState);
        BeaconBlockHeader memory anchorHeader = scene.anchorBodyEvidence.header;
        scene.anchorRoot = SSZ.hashTreeRootMemory(anchorHeader);

        scene.proof = _proofOf(
            anchorHeader, depositHeader, anchorState.extraBranches[0], hashBranch, sourceState.fork, headerRlp, named
        );
        scene.rootsEvidence = BeaconProofVerifier.BlockRootsEvidence({
            laterHeader: anchorHeader,
            earlierSlotA: _fillerSlotA(params),
            earlierSlotB: _fillerSlotB(params),
            branchA: anchorState.extraBranches[1],
            branchB: anchorState.extraBranches[2]
        });

        (scene.evidenceBefore, scene.evidenceBeforeBranch) = _bodyEvidenceHeader(params.depositSlot - 40, params.blockHashGindex, params.genesisRoot);
        (scene.evidenceAfter, scene.evidenceAfterBranch) = _bodyEvidenceHeader(params.depositSlot + 40, params.blockHashGindex, params.genesisRoot);
    }

    /// @notice The anchor state of a scene: a sparse state of the shape of the `block_roots` position, holding the source
    /// root and the two filler roots in `block_roots` (the extra branches 0 to 2), and the genesis validators root and the
    /// version of its fork proof.
    function _anchorState(SceneParams memory params, bytes32 sourceRoot)
        internal
        pure
        returns (ForkProofs.ForkedState memory)
    {
        uint256[] memory gindices = new uint256[](3);
        bytes32[] memory leaves = new bytes32[](3);
        gindices[0] = params.blockRootsGindex * 8192 + (params.depositSlot % 8192);
        leaves[0] = sourceRoot;
        gindices[1] = params.blockRootsGindex * 8192 + (_fillerSlotA(params) % 8192);
        leaves[1] = _fillerRoot(_fillerSlotA(params));
        gindices[2] = params.blockRootsGindex * 8192 + (_fillerSlotB(params) % 8192);
        leaves[2] = _fillerRoot(_fillerSlotB(params));
        uint8 shape = ForkProofs.shapeOfBlockRoots(params.blockRootsGindex);
        return ForkProofs.stateWith(shape, params.genesisRoot, ForkProofs.versionOf(shape), gindices, leaves);
    }

    /// @notice The anchor header of a scene and its block hash evidence: its body holds its own stored execution block hash
    /// at `params.anchorBodyGindex`, and its state is `anchorState`.
    function _anchorBodyEvidence(SceneParams memory params, ForkProofs.ForkedState memory anchorState)
        internal
        pure
        returns (BeaconProofVerifier.BlockHashEvidence memory)
    {
        bytes32[] memory branch = _siblings(SSZ.depthOf(params.anchorBodyGindex), "anchor body", params.anchorSlot);
        BeaconBlockHeader memory header = BeaconBlockHeader({
            slot: params.anchorSlot,
            proposerIndex: 9,
            parentRoot: keccak256(abi.encode("anchor parent", params.anchorSlot)),
            stateRoot: anchorState.root,
            bodyRoot: _rootFromBranch(_execHash(params.anchorSlot), branch, params.anchorBodyGindex)
        });
        return BeaconProofVerifier.BlockHashEvidence(header, branch, anchorState.fork);
    }

    /// @notice A header whose body holds `keccak256(abi.encode("exec", slot))` at `gindex`. Its state is `_plainState`.
    function _bodyEvidenceHeader(uint64 slot, uint256 gindex)
        internal
        pure
        returns (BeaconBlockHeader memory header, bytes32[] memory branch)
    {
        return _bodyEvidenceHeader(slot, gindex, GENESIS_ROOT_A);
    }

    /// @notice The same, for the chain with `genesisRoot`: its state is `_plainState(genesisRoot)`.
    function _bodyEvidenceHeader(uint64 slot, uint256 gindex, bytes32 genesisRoot)
        internal
        pure
        returns (BeaconBlockHeader memory header, bytes32[] memory branch)
    {
        branch = _siblings(SSZ.depthOf(gindex), "evidence body", slot);
        header = BeaconBlockHeader({
            slot: slot,
            proposerIndex: 3,
            parentRoot: keccak256(abi.encode("evidence parent", slot)),
            stateRoot: _plainState(genesisRoot).root,
            bodyRoot: _rootFromBranch(_execHash(slot), branch, gindex)
        });
    }

    /// @notice The plain state (depth 6, before Gloas) of chain A that the source headers and the body evidence headers of
    /// the scenes share: it holds `GENESIS_ROOT_A`, the root that `lightClientForB` tracks.
    function _plainState() internal pure returns (ForkProofs.ForkedState memory) {
        return _plainState(GENESIS_ROOT_A);
    }

    /// @notice The same plain state for the chain with `genesisRoot`.
    function _plainState(bytes32 genesisRoot) internal pure returns (ForkProofs.ForkedState memory) {
        return ForkProofs.state(6, genesisRoot);
    }

    /// @notice Block hash evidence for a header whose state is `_plainState`.
    function _hashEvidence(BeaconBlockHeader memory header, bytes32[] memory branch)
        internal
        pure
        returns (BeaconProofVerifier.BlockHashEvidence memory)
    {
        return _hashEvidence(header, branch, GENESIS_ROOT_A);
    }

    /// @notice Block hash evidence for a header whose state is `_plainState(genesisRoot)`.
    function _hashEvidence(BeaconBlockHeader memory header, bytes32[] memory branch, bytes32 genesisRoot)
        internal
        pure
        returns (BeaconProofVerifier.BlockHashEvidence memory)
    {
        return BeaconProofVerifier.BlockHashEvidence(header, branch, _plainState(genesisRoot).fork);
    }

    // ---------------------------------------------------------------- tree helpers

    function _siblings(uint256 depth, string memory tag, uint64 slot) internal pure returns (bytes32[] memory out) {
        out = new bytes32[](depth);
        for (uint256 i = 0; i < depth; i++) {
            out[i] = keccak256(abi.encode("sibling", tag, slot, i));
        }
    }

    /// @notice Computes the root from a leaf, siblings, and a generalized index (independent of the code path of the bridge).
    function _rootFromBranch(bytes32 leaf, bytes32[] memory branch, uint256 gindex) internal pure returns (bytes32 node) {
        node = leaf;
        for (uint256 i = 0; i < branch.length; i++) {
            node = (gindex >> i) & 1 == 1
                ? sha256(abi.encodePacked(branch[i], node))
                : sha256(abi.encodePacked(node, branch[i]));
        }
    }

    /// @notice The root and the branches of a Merkle tree that holds the given leaves at the given generalized indices
    /// (all of the same depth) and zero everywhere else.
    function _sparseTree(uint256[] memory gindices, bytes32[] memory leaves)
        internal
        pure
        returns (bytes32 root, bytes32[][] memory branches)
    {
        uint256 depth = SSZ.depthOf(gindices[0]);
        uint256 count = gindices.length;
        branches = new bytes32[][](count);
        uint256[] memory index = new uint256[](count);
        bytes32[] memory value = new bytes32[](count);
        bytes32 zero = bytes32(0);
        for (uint256 k = 0; k < count; k++) {
            branches[k] = new bytes32[](depth);
            index[k] = gindices[k];
            value[k] = leaves[k];
        }
        for (uint256 level = 0; level < depth; level++) {
            bytes32[] memory next = new bytes32[](count);
            for (uint256 k = 0; k < count; k++) {
                bytes32 sibling = zero;
                for (uint256 j = 0; j < count; j++) {
                    if (index[j] == (index[k] ^ 1)) sibling = value[j];
                }
                branches[k][level] = sibling;
                next[k] = index[k] & 1 == 1
                    ? sha256(abi.encodePacked(sibling, value[k]))
                    : sha256(abi.encodePacked(value[k], sibling));
            }
            for (uint256 k = 0; k < count; k++) {
                index[k] >>= 1;
                value[k] = next[k];
            }
            zero = sha256(abi.encodePacked(zero, zero));
        }
        root = value[0];
    }

    // ---------------------------------------------------------------- execution header

    /// @notice An RLP-encoded execution header with `fieldCount` items. The sixth item is the receipts root.
    /// A full post-Shanghai header has 17 items. Fewer items model a truncated header.
    function _executionHeaderRlp(bytes32 receiptsRoot, uint256 fieldCount) internal pure returns (bytes memory) {
        return _executionHeaderRlp(receiptsRoot, keccak256("transactions root"), fieldCount);
    }

    /// @notice The same, with a chosen transactions root (the fifth item).
    function _executionHeaderRlp(bytes32 receiptsRoot, bytes32 transactionsRoot, uint256 fieldCount)
        internal
        pure
        returns (bytes memory)
    {
        bytes[] memory items = new bytes[](fieldCount);
        bytes[17] memory all = [
            _rlpBytes(abi.encodePacked(keccak256("parent"))),
            _rlpBytes(abi.encodePacked(keccak256("ommers"))),
            _rlpBytes(abi.encodePacked(address(0xC0FFEE))),
            _rlpBytes(abi.encodePacked(keccak256("state root"))),
            _rlpBytes(abi.encodePacked(transactionsRoot)),
            _rlpBytes(abi.encodePacked(receiptsRoot)),
            _rlpBytes(new bytes(256)),
            _rlpBytes(""),
            _rlpBytes(hex"0186a0"),
            _rlpBytes(hex"01c9c380"),
            _rlpBytes(hex"5208"),
            _rlpBytes(hex"65f1a2b3"),
            _rlpBytes("pulse"),
            _rlpBytes(abi.encodePacked(keccak256("mix"))),
            _rlpBytes(new bytes(8)),
            _rlpBytes(hex"3b9aca00"),
            _rlpBytes(abi.encodePacked(keccak256("withdrawals root")))
        ];
        for (uint256 i = 0; i < fieldCount; i++) {
            items[i] = all[i];
        }
        return _rlpList(items);
    }

    function _rlpBytes(bytes memory data) internal pure returns (bytes memory) {
        if (data.length == 1 && uint8(data[0]) < 0x80) return data;
        return bytes.concat(_rlpPrefix(data.length, 0x80), data);
    }

    function _rlpList(bytes[] memory encodedItems) internal pure returns (bytes memory) {
        bytes memory body;
        for (uint256 i = 0; i < encodedItems.length; i++) {
            body = bytes.concat(body, encodedItems[i]);
        }
        return bytes.concat(_rlpPrefix(body.length, 0xc0), body);
    }

    function _rlpPrefix(uint256 length, uint8 offset) private pure returns (bytes memory) {
        if (length < 56) return abi.encodePacked(uint8(offset + length));
        bytes memory size = abi.encodePacked(length);
        uint256 skip;
        while (size[skip] == 0) skip++;
        bytes memory trimmed = new bytes(size.length - skip);
        for (uint256 i = 0; i < trimmed.length; i++) {
            trimmed[i] = size[skip + i];
        }
        return bytes.concat(abi.encodePacked(uint8(offset + 55 + trimmed.length)), trimmed);
    }

    // ---------------------------------------------------------------- copies

    /// @notice A deep copy, because memory structs are references.
    function _clone(MessageBridge.MessageProof memory proof) internal pure returns (MessageBridge.MessageProof memory) {
        return abi.decode(abi.encode(proof), (MessageBridge.MessageProof));
    }

    /// @dev The proof of one fixture message with the given beacon part. The call builds a deep copy, so a test that
    /// edits the proof never edits the scene.
    function _proofOf(
        BeaconBlockHeader memory anchor,
        BeaconBlockHeader memory source,
        bytes32[] memory ancestryBranch,
        bytes32[] memory blockHashBranch,
        BeaconProofVerifier.ForkProof memory sourceFork,
        bytes memory executionHeaderRlp,
        MessageFixtures.Named memory named
    ) internal pure returns (MessageBridge.MessageProof memory) {
        return _clone(
            MessageBridge.MessageProof({
                anchorHeader: anchor,
                sourceHeader: source,
                ancestryBranch: ancestryBranch,
                blockHashBranch: blockHashBranch,
                sourceFork: sourceFork,
                executionHeaderRlp: executionHeaderRlp,
                receiptProof: MessageFixtures.receiptProofFor(named.transactionIndex),
                receiptIndex: named.transactionIndex,
                transactionProof: MessageFixtures.transactionProofFor(named.transactionIndex),
                transactionIndex: named.transactionIndex,
                logIndex: named.logIndex
            })
        );
    }

    /// @dev The proof of one fixture message in a scene.
    function _messageProof(Scene memory scene, MessageFixtures.Named memory named)
        internal
        pure
        returns (MessageBridge.MessageProof memory)
    {
        return _proofOf(
            scene.proof.anchorHeader,
            scene.proof.sourceHeader,
            scene.proof.ancestryBranch,
            scene.proof.blockHashBranch,
            scene.proof.sourceFork,
            scene.proof.executionHeaderRlp,
            named
        );
    }
}
