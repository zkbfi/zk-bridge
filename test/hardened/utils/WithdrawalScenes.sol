pragma solidity ^0.8.24;

import {BeaconLightClient} from "../../../src/hardened/BeaconLightClient.sol";
import {BridgeVault} from "../../../src/hardened/BridgeVault.sol";
import {BeaconBlockHeader, SSZ} from "../../../src/hardened/SSZ.sol";
import {HardenedFixture} from "./HardenedFixture.sol";
import {ReceiptFixtures} from "./ReceiptFixtures.sol";

/// @notice Builds synthetic withdrawal evidence. The receipts trie and its proofs come from `ReceiptFixtures`
/// (generated by a script). The beacon levels above the receipts are built here, as real sparse Merkle trees, so that
/// the same anchor can prove a deposit header AND validate the vault's fork layout from stored data.
///
/// One scene stores these headers in the light client, in slot order: two body evidence headers around the deposit
/// slot (D - 40 and D + 40), two filler headers (A - 80 and A - 40), and the anchor A. Then it adds the layouts to every
/// vault that the test created.
abstract contract WithdrawalScenes is HardenedFixture {
    /// @param anchorSlot The slot A of the anchor header.
    /// @param depositSlot The slot D of the deposit header.
    /// @param blockRootsGindex The `block_roots` position in the state of the anchor.
    /// @param anchorBodyGindex The block hash position in the body of the anchor and of the evidence headers.
    /// @param blockHashGindex The block hash position in the body of the deposit header and of its evidence headers.
    struct SceneParams {
        uint64 anchorSlot;
        uint64 depositSlot;
        uint256 blockRootsGindex;
        uint256 anchorBodyGindex;
        uint256 blockHashGindex;
    }

    /// @notice The result of building a scene.
    struct Scene {
        BridgeVault.WithdrawalProof proof;
        bytes32 anchorRoot;
        bytes32 blockHash;
        BridgeVault.BlockRootsEvidence rootsEvidence;
        BridgeVault.BlockHashEvidence anchorBodyEvidence;
        BeaconBlockHeader evidenceBefore;
        bytes32[] evidenceBeforeBranch;
        BeaconBlockHeader evidenceAfter;
        bytes32[] evidenceAfterBranch;
    }

    /// @dev The storage slots of a vault that a test can change: `depositCount` and the three layout lengths. The token
    /// maps are cleared by key. A test that wipes a vault has claimed nothing yet.
    uint256 internal constant DEPOSIT_COUNT_SLOT = 0;
    uint256 internal constant STATE_LAYOUTS_LENGTH_SLOT = 4;
    uint256 internal constant BODY_LAYOUTS_LENGTH_SLOT = 5;
    uint256 internal constant HISTORICAL_LAYOUTS_LENGTH_SLOT = 6;
    uint256 internal constant REMOTE_TOKEN_OF_SLOT = 1;
    uint256 internal constant LOCAL_TOKEN_OF_SLOT = 2;
    uint64 internal constant FIRST_ANCHOR_SLOT = 826_000;
    uint64 internal nextAnchorSlot;
    BridgeVault[] internal createdVaults;
    /// @dev Every pair of every vault built at `DESTINATION_VAULT` in this test. A wipe clears their map entries.
    BridgeVault.TokenPair[] internal destinationPairs;

    function setUp() public virtual override {
        super.setUp();
        nextAnchorSlot = FIRST_ANCHOR_SLOT;
    }

    // ---------------------------------------------------------------- vault under test

    /// @notice A vault on chain B for the fixture receipts: remote vault and remote token are the fixture constants.
    /// It has no fork layouts yet. `_scene` adds them to every vault that this function returned.
    function _newWithdrawalVault() internal returns (BridgeVault) {
        return _newWithdrawalVault(0);
    }

    function _newWithdrawalVault(uint64 depositCutoff) internal returns (BridgeVault vault_) {
        return _newWithdrawalVault(depositCutoff, DEFAULT_CAPELLA_ERA);
    }

    function _newWithdrawalVault(uint64 depositCutoff, uint64 capellaEra) internal returns (BridgeVault vault_) {
        return _newWithdrawalVault(depositCutoff, capellaEra, address(0));
    }

    /// @notice The same, with a flow limiter. A zero address means none.
    function _newWithdrawalVault(uint64 depositCutoff, uint64 capellaEra, address flowLimiter)
        internal
        returns (BridgeVault vault_)
    {
        BridgeVault.TokenPair[] memory pairs = new BridgeVault.TokenPair[](1);
        pairs[0] = BridgeVault.TokenPair(address(tokenOnB), ReceiptFixtures.REMOTE_TOKEN, 18);
        return _newDestinationVault(pairs, depositCutoff, capellaEra, flowLimiter);
    }

    /// @notice A vault on chain B for the given pairs, built at `DESTINATION_VAULT`, the only address that the fixture
    /// receipts name. An earlier vault of the same test at that address is wiped first (code, counters, layouts and
    /// token maps), so the new one starts clean. A test that needs two live vaults builds the second with
    /// `_newSecondWithdrawalVault`. `_scene` adds the fork layouts to every vault that this function returned.
    function _newDestinationVault(BridgeVault.TokenPair[] memory pairs, uint64 depositCutoff, uint64 capellaEra)
        internal
        returns (BridgeVault vault_)
    {
        return _newDestinationVault(pairs, depositCutoff, capellaEra, address(0));
    }

    /// @notice The same, with a flow limiter. A zero address means none.
    function _newDestinationVault(
        BridgeVault.TokenPair[] memory pairs,
        uint64 depositCutoff,
        uint64 capellaEra,
        address flowLimiter
    ) internal returns (BridgeVault vault_) {
        vm.chainId(CHAIN_B);
        address destination = ReceiptFixtures.DESTINATION_VAULT;
        vm.etch(destination, "");
        _wipeVaultState(destination);
        bytes memory arguments = abi.encode(
            address(lightClientForB), CHAIN_B, CHAIN_A, ReceiptFixtures.REMOTE_VAULT, pairs,
            BridgeVault.VaultTerms(depositCutoff, address(0), address(0), 0, 0, flowLimiter, address(lightClientForA)), capellaEra, address(gateB)
        );
        deployCodeTo("BridgeVault.sol:BridgeVault", arguments, destination);
        for (uint256 i = 0; i < pairs.length; i++) {
            destinationPairs.push(pairs[i]);
        }
        vault_ = BridgeVault(destination);
        _openDepositsWithoutProof(vault_);
        createdVaults.push(vault_);
    }

    /// @notice A vault like the one above, at an ordinary address. It has the same remote vault as the first, and it is
    /// not the destination named in the fixture receipts, so it must refuse them with `WrongDestinationVault`.
    function _newSecondWithdrawalVault() internal returns (BridgeVault vault_) {
        return _newSecondWithdrawalVault(0, DEFAULT_CAPELLA_ERA);
    }

    /// @notice The same, with a deposit cutoff and a `capellaEra`.
    function _newSecondWithdrawalVault(uint64 depositCutoff, uint64 capellaEra) internal returns (BridgeVault vault_) {
        BridgeVault.TokenPair[] memory pairs = new BridgeVault.TokenPair[](1);
        pairs[0] = BridgeVault.TokenPair(address(tokenOnB), ReceiptFixtures.REMOTE_TOKEN, 18);
        vm.chainId(CHAIN_B);
        vault_ = new BridgeVault(
            address(lightClientForB), CHAIN_B, CHAIN_A, ReceiptFixtures.REMOTE_VAULT, pairs, BridgeVault.VaultTerms(depositCutoff, address(0), address(0), 0, 0, address(0), address(lightClientForA)), capellaEra, address(gateB)
        );
        _openDepositsWithoutProof(vault_);
        createdVaults.push(vault_);
    }

    /// @dev Clears the counters, the layout tables and the token maps of every earlier vault at `vaultAddress`.
    function _wipeVaultState(address vaultAddress) internal {
        vm.store(vaultAddress, bytes32(DEPOSIT_COUNT_SLOT), bytes32(0));
        vm.store(vaultAddress, bytes32(STATE_LAYOUTS_LENGTH_SLOT), bytes32(0));
        vm.store(vaultAddress, bytes32(BODY_LAYOUTS_LENGTH_SLOT), bytes32(0));
        vm.store(vaultAddress, bytes32(HISTORICAL_LAYOUTS_LENGTH_SLOT), bytes32(0));
        for (uint256 i = 0; i < destinationPairs.length; i++) {
            vm.store(vaultAddress, keccak256(abi.encode(destinationPairs[i].localToken, REMOTE_TOKEN_OF_SLOT)), bytes32(0));
            vm.store(vaultAddress, keccak256(abi.encode(destinationPairs[i].remoteToken, LOCAL_TOKEN_OF_SLOT)), bytes32(0));
        }
    }

    /// @notice The default scene: anchor in an Electra-like fork (state position 69, block hash position 812), deposit
    /// 2000 slots earlier with the Deneb block hash position 812 too.
    function _defaultParams() internal returns (SceneParams memory) {
        uint64 anchorSlot = nextAnchorSlot;
        nextAnchorSlot = anchorSlot + 200; // room for the evidence headers of the next scene
        return SceneParams({
            anchorSlot: anchorSlot,
            depositSlot: anchorSlot - 2000,
            blockRootsGindex: 69,
            anchorBodyGindex: 812,
            blockHashGindex: 812
        });
    }

    // ---------------------------------------------------------------- slot helpers

    function _fillerSlotA(SceneParams memory p) internal pure returns (uint64) {
        return p.anchorSlot - 80;
    }

    function _fillerSlotB(SceneParams memory p) internal pure returns (uint64) {
        return p.anchorSlot - 40;
    }

    function _fillerRoot(uint64 slot) internal pure returns (bytes32) {
        return keccak256(abi.encode("filler header root", slot));
    }

    // ---------------------------------------------------------------- scene building

    /// @notice Builds a scene for one named receipt, stores its headers, and adds the layouts to every created vault.
    function _scene(ReceiptFixtures.Named memory named, SceneParams memory params) internal returns (Scene memory scene) {
        return _sceneWithHeader(named, params, _executionHeaderRlp(ReceiptFixtures.RECEIPTS_ROOT, 17));
    }

    function _sceneWithHeader(ReceiptFixtures.Named memory named, SceneParams memory params, bytes memory headerRlp)
        internal
        returns (Scene memory scene)
    {
        scene = _buildScene(named, params, headerRlp);
        _storeScene(params, scene);
        for (uint256 i = 0; i < createdVaults.length; i++) {
            _addLayouts(createdVaults[i], params, scene);
        }
    }

    /// @notice Stores the headers of a scene in the light client, in slot order. Slots at or below the head are skipped:
    /// an earlier scene stored them.
    function _storeScene(SceneParams memory params, Scene memory scene) internal {
        _storeIfAhead(scene.evidenceBefore.slot, SSZ.hashTreeRootMemory(scene.evidenceBefore));
        _storeIfAhead(scene.evidenceAfter.slot, SSZ.hashTreeRootMemory(scene.evidenceAfter));
        _storeIfAhead(_fillerSlotA(params), _fillerRoot(_fillerSlotA(params)));
        _storeIfAhead(_fillerSlotB(params), _fillerRoot(_fillerSlotB(params)));
        _storeIfAhead(params.anchorSlot, scene.anchorRoot);
    }

    function _storeIfAhead(uint64 slot, bytes32 headerRoot) internal {
        if (slot <= lightClientForB.head()) return;
        _storeAnchor(slot, headerRoot);
    }

    /// @notice Stores `headerRoot` as the finalized header at `slot` through an honest update. The execution block hash
    /// is `keccak256(abi.encode("exec", slot))`.
    function _storeAnchor(uint64 slot, bytes32 headerRoot) internal {
        BeaconLightClient.LightClientOutput memory output =
            _outputAt(lightClientForB, GENESIS_ROOT_A, slot, _execHash(slot));
        output.newHeaderRoot = headerRoot;
        _submit(lightClientForB, output);
    }

    function _execHash(uint64 slot) internal pure returns (bytes32) {
        return keccak256(abi.encode("exec", slot));
    }

    /// @notice Adds the layouts of a scene to `vault`, where the evidence is stored. Layouts the vault already
    /// holds are widened.
    function _addLayouts(BridgeVault vault_, SceneParams memory params, Scene memory scene) internal {
        if (lightClientForB.headers(scene.evidenceBefore.slot) == SSZ.hashTreeRootMemory(scene.evidenceBefore)) {
            vault_.addBlockHashLayout(
                params.blockHashGindex, BridgeVault.BlockHashEvidence(scene.evidenceBefore, scene.evidenceBeforeBranch)
            );
        }
        if (lightClientForB.headers(scene.evidenceAfter.slot) == SSZ.hashTreeRootMemory(scene.evidenceAfter)) {
            vault_.addBlockHashLayout(
                params.blockHashGindex, BridgeVault.BlockHashEvidence(scene.evidenceAfter, scene.evidenceAfterBranch)
            );
        }
        if (lightClientForB.headers(params.anchorSlot) == scene.anchorRoot) {
            vault_.addBlockRootsLayout(params.blockRootsGindex, scene.rootsEvidence);
            vault_.addBlockHashLayout(params.anchorBodyGindex, scene.anchorBodyEvidence);
        }
    }

    /// @notice Builds a scene with an explicit execution header encoding. Nothing is stored.
    function _buildScene(ReceiptFixtures.Named memory named, SceneParams memory params, bytes memory headerRlp)
        internal
        pure
        returns (Scene memory scene)
    {
        scene.blockHash = keccak256(headerRlp);

        // Deposit header: its body holds the execution block hash at the deposit position.
        bytes32[] memory hashBranch = _siblings(SSZ.depthOf(params.blockHashGindex), "hash", params.depositSlot);
        BeaconBlockHeader memory depositHeader = BeaconBlockHeader({
            slot: params.depositSlot,
            proposerIndex: 7,
            parentRoot: keccak256(abi.encode("deposit parent", params.depositSlot)),
            stateRoot: keccak256(abi.encode("deposit state", params.depositSlot)),
            bodyRoot: _rootFromBranch(scene.blockHash, hashBranch, params.blockHashGindex)
        });

        // Anchor state: a sparse block_roots tree holding the deposit root and the two filler roots.
        uint256[] memory gindices = new uint256[](3);
        bytes32[] memory leaves = new bytes32[](3);
        gindices[0] = params.blockRootsGindex * 8192 + (params.depositSlot % 8192);
        leaves[0] = SSZ.hashTreeRootMemory(depositHeader);
        gindices[1] = params.blockRootsGindex * 8192 + (_fillerSlotA(params) % 8192);
        leaves[1] = _fillerRoot(_fillerSlotA(params));
        gindices[2] = params.blockRootsGindex * 8192 + (_fillerSlotB(params) % 8192);
        leaves[2] = _fillerRoot(_fillerSlotB(params));
        (bytes32 stateRoot, bytes32[][] memory branches) = _sparseTree(gindices, leaves);

        // Anchor body: the anchor's own stored execution block hash at the anchor position.
        bytes32[] memory anchorBodyBranch = _siblings(SSZ.depthOf(params.anchorBodyGindex), "anchor body", params.anchorSlot);
        BeaconBlockHeader memory anchorHeader = BeaconBlockHeader({
            slot: params.anchorSlot,
            proposerIndex: 9,
            parentRoot: keccak256(abi.encode("anchor parent", params.anchorSlot)),
            stateRoot: stateRoot,
            bodyRoot: _rootFromBranch(_execHash(params.anchorSlot), anchorBodyBranch, params.anchorBodyGindex)
        });
        scene.anchorRoot = SSZ.hashTreeRootMemory(anchorHeader);

        scene.proof = BridgeVault.WithdrawalProof({
            anchorHeader: anchorHeader,
            depositHeader: depositHeader,
            ancestryBranch: branches[0],
            blockHashBranch: hashBranch,
            executionHeaderRlp: headerRlp,
            receiptProof: ReceiptFixtures.proofFor(named.transactionIndex),
            transactionIndex: named.transactionIndex,
            logIndex: named.logIndex
        });
        scene.rootsEvidence = BridgeVault.BlockRootsEvidence({
            laterHeader: anchorHeader,
            earlierSlotA: _fillerSlotA(params),
            earlierSlotB: _fillerSlotB(params),
            branchA: branches[1],
            branchB: branches[2]
        });
        scene.anchorBodyEvidence = BridgeVault.BlockHashEvidence(anchorHeader, anchorBodyBranch);

        (scene.evidenceBefore, scene.evidenceBeforeBranch) = _bodyEvidenceHeader(params.depositSlot - 40, params.blockHashGindex);
        (scene.evidenceAfter, scene.evidenceAfterBranch) = _bodyEvidenceHeader(params.depositSlot + 40, params.blockHashGindex);
    }

    /// @notice A header whose body holds `keccak256(abi.encode("exec", slot))` at `gindex`.
    function _bodyEvidenceHeader(uint64 slot, uint256 gindex)
        internal
        pure
        returns (BeaconBlockHeader memory header, bytes32[] memory branch)
    {
        branch = _siblings(SSZ.depthOf(gindex), "evidence body", slot);
        header = BeaconBlockHeader({
            slot: slot,
            proposerIndex: 3,
            parentRoot: keccak256(abi.encode("evidence parent", slot)),
            stateRoot: keccak256(abi.encode("evidence state", slot)),
            bodyRoot: _rootFromBranch(_execHash(slot), branch, gindex)
        });
    }

    // ---------------------------------------------------------------- tree helpers

    function _siblings(uint256 depth, string memory tag, uint64 slot) internal pure returns (bytes32[] memory out) {
        out = new bytes32[](depth);
        for (uint256 i = 0; i < depth; i++) {
            out[i] = keccak256(abi.encode("sibling", tag, slot, i));
        }
    }

    /// @notice Computes the root from a leaf, siblings, and a generalized index (independent of the vault's code path).
    function _rootFromBranch(bytes32 leaf, bytes32[] memory branch, uint256 gindex) internal pure returns (bytes32 node) {
        node = leaf;
        for (uint256 i = 0; i < branch.length; i++) {
            node = (gindex >> i) & 1 == 1
                ? sha256(abi.encodePacked(branch[i], node))
                : sha256(abi.encodePacked(node, branch[i]));
        }
    }

    /// @notice The root and the branches of a Merkle tree that holds the given leaves at the given generalized indices
    /// (all of the same depth) and zero everywhere else.
    function _sparseTree(uint256[] memory gindices, bytes32[] memory leaves)
        internal
        pure
        returns (bytes32 root, bytes32[][] memory branches)
    {
        uint256 depth = SSZ.depthOf(gindices[0]);
        uint256 count = gindices.length;
        branches = new bytes32[][](count);
        uint256[] memory index = new uint256[](count);
        bytes32[] memory value = new bytes32[](count);
        bytes32 zero = bytes32(0);
        for (uint256 k = 0; k < count; k++) {
            branches[k] = new bytes32[](depth);
            index[k] = gindices[k];
            value[k] = leaves[k];
        }
        for (uint256 level = 0; level < depth; level++) {
            bytes32[] memory next = new bytes32[](count);
            for (uint256 k = 0; k < count; k++) {
                bytes32 sibling = zero;
                for (uint256 j = 0; j < count; j++) {
                    if (index[j] == (index[k] ^ 1)) sibling = value[j];
                }
                branches[k][level] = sibling;
                next[k] = index[k] & 1 == 1
                    ? sha256(abi.encodePacked(sibling, value[k]))
                    : sha256(abi.encodePacked(value[k], sibling));
            }
            for (uint256 k = 0; k < count; k++) {
                index[k] >>= 1;
                value[k] = next[k];
            }
            zero = sha256(abi.encodePacked(zero, zero));
        }
        root = value[0];
    }

    // ---------------------------------------------------------------- execution header

    /// @notice An RLP-encoded execution header with `fieldCount` items. The sixth item is the receipts root.
    /// A full post-Shanghai header has 17 items. Fewer items model a truncated header.
    function _executionHeaderRlp(bytes32 receiptsRoot, uint256 fieldCount) internal pure returns (bytes memory) {
        bytes[] memory items = new bytes[](fieldCount);
        bytes[17] memory all = [
            _rlpBytes(abi.encodePacked(keccak256("parent"))),
            _rlpBytes(abi.encodePacked(keccak256("ommers"))),
            _rlpBytes(abi.encodePacked(address(0xC0FFEE))),
            _rlpBytes(abi.encodePacked(keccak256("state root"))),
            _rlpBytes(abi.encodePacked(keccak256("transactions root"))),
            _rlpBytes(abi.encodePacked(receiptsRoot)),
            _rlpBytes(new bytes(256)),
            _rlpBytes(""),
            _rlpBytes(hex"0186a0"),
            _rlpBytes(hex"01c9c380"),
            _rlpBytes(hex"5208"),
            _rlpBytes(hex"65f1a2b3"),
            _rlpBytes("pulse"),
            _rlpBytes(abi.encodePacked(keccak256("mix"))),
            _rlpBytes(new bytes(8)),
            _rlpBytes(hex"3b9aca00"),
            _rlpBytes(abi.encodePacked(keccak256("withdrawals root")))
        ];
        for (uint256 i = 0; i < fieldCount; i++) {
            items[i] = all[i];
        }
        return _rlpList(items);
    }

    function _rlpBytes(bytes memory data) internal pure returns (bytes memory) {
        if (data.length == 1 && uint8(data[0]) < 0x80) return data;
        return bytes.concat(_rlpPrefix(data.length, 0x80), data);
    }

    function _rlpList(bytes[] memory encodedItems) internal pure returns (bytes memory) {
        bytes memory body;
        for (uint256 i = 0; i < encodedItems.length; i++) {
            body = bytes.concat(body, encodedItems[i]);
        }
        return bytes.concat(_rlpPrefix(body.length, 0xc0), body);
    }

    function _rlpPrefix(uint256 length, uint8 offset) private pure returns (bytes memory) {
        if (length < 56) return abi.encodePacked(uint8(offset + length));
        bytes memory size = abi.encodePacked(length);
        uint256 skip;
        while (size[skip] == 0) skip++;
        bytes memory trimmed = new bytes(size.length - skip);
        for (uint256 i = 0; i < trimmed.length; i++) {
            trimmed[i] = size[skip + i];
        }
        return bytes.concat(abi.encodePacked(uint8(offset + 55 + trimmed.length)), trimmed);
    }

    // ---------------------------------------------------------------- copies

    /// @notice A deep copy, because memory structs are references.
    function _clone(BridgeVault.WithdrawalProof memory proof) internal pure returns (BridgeVault.WithdrawalProof memory) {
        return abi.decode(abi.encode(proof), (BridgeVault.WithdrawalProof));
    }
}
