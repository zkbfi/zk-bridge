# The configuration of the prover for the end-to-end run. e2e/deploy.sh fills the placeholders.
# The paths are relative to the repository root, where the prover runs.
database_path = "@@STATE_DIR@@/prover.sqlite"
poll_interval_seconds = 3
receipt_timeout_seconds = 90
max_attempts = @@MAX_ATTEMPTS@@
max_withdrawals_per_pass = 32

[signer]
keystore = "@@STATE_DIR@@/keys/prover"
password_file = "@@STATE_DIR@@/keys/prover.password"

[prover]
backend = "@@BACKEND@@"
program_vkey = "@@PROGRAM_VKEY@@"
# One proof for each process: SP1 keeps memory after a Groth16 proof, and the loop of e2e/prover-loop.sh starts a new process.
max_proofs_per_process = 1
@@PROVER_EXTRA@@

[chain_a]
name = "chain-a"
rpc_url = "@@RPC_A@@"
start_block = @@START_BLOCK_A@@
chain_id = 1
vault = "@@VAULT_A@@"
light_client = "@@LIGHT_CLIENT_A@@"
[chain_a.beacon]
kind = "http"
url = "@@BEACON@@/a"
chain = "ethereum"

[chain_b]
name = "chain-b"
rpc_url = "@@RPC_B@@"
start_block = @@START_BLOCK_B@@
chain_id = 369
vault = "@@VAULT_B@@"
light_client = "@@LIGHT_CLIENT_B@@"
[chain_b.beacon]
kind = "http"
url = "@@BEACON@@/b"
chain = "pulsechain"
